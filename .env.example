# =====================================================================
# ZOTH CIVILIZATION — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this template to .env.sovereign for local development.
# NEVER commit .env.sovereign or any real API keys to version control.
# =====================================================================

# Loopback HTTP & SSE Server
HOST=127.0.0.1
PORT=9393

# Local Hermes / Ollama Voice-in-World Model (engine/local_talk.js)
ZOTH_TALK_MODEL=hermes3-teknium:latest
OLLAMA_PORT=11434

# Optional Upstream BYOK / Hermes Agent Inference Keys (never persisted by /api/llm/proxy)
NOUS_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional Kokoro ONNX Voice Worker (0 = Thermal Conservation Guard <55C ceiling)
ENABLE_KOKORO_VOICE=0

# Optional Stripe Secret Key (restricted/test key for server-side link generation)
STRIPE_SECRET_KEY=

# Local Workspace Root
WORKSPACE_ROOT=~/NullAITech
